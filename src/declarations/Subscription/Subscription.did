type WriterSubscriptionDetails = 
 record {
   annuallyFee: opt text;
   isSubscriptionActive: bool;
   lifeTimeFee: opt text;
   monthlyFee: opt text;
   paymentReceiverPrincipalId: text;
   stripeAccountId: opt text;
   stripeIsActive: bool;
   stripePricing: vec record {
                        SubscriptionTimeInterval;
                        text;
                        text;
                      };
   weeklyFee: opt text;
   writerPrincipalId: text;
   writerSubscriptions: vec SubscriptionEvent;
 };
type UpdateSubscriptionDetailsModel = 
 record {
   annuallyFee: opt nat;
   lifeTimeFee: opt nat;
   monthlyFee: opt nat;
   publicationInformation: opt record {
                                 principal;
                                 text;
                               };
   weeklyFee: opt nat;
 };
type SupportedStandard = 
 record {
   name: text;
   url: text;
 };
type SubscriptionTimeInterval = 
 variant {
   Annually;
   LifeTime;
   Monthly;
   Weekly;
 };
type SubscriptionEvent = 
 record {
   endTime: int;
   isWriterSubscriptionActive: bool;
   paymentFee: text;
   paymentMethod: opt PaymentMethod;
   readerPrincipalId: text;
   startTime: int;
   stripeCancelAtPeriodEnd: opt bool;
   subscriptionEventId: text;
   subscriptionTimeInterval: SubscriptionTimeInterval;
   writerPrincipalId: text;
 };
type Result_5 = 
 variant {
   err: text;
   ok: PaymentRequest;
 };
type Result_4 = 
 variant {
   err: text;
   ok: nat;
 };
type Result_3 = 
 variant {
   err: text;
   ok: text;
 };
type Result_2 = 
 variant {
   err: text;
   ok: ReaderSubscriptionDetails;
 };
type Result_1 = 
 variant {
   err: text;
   ok;
 };
type Result = 
 variant {
   err: text;
   ok: WriterSubscriptionDetails;
 };
type ReaderSubscriptionDetails = 
 record {
   readerNotStoppedSubscriptionsWriters: vec WriterSubscriptionDetails;
   readerPrincipalId: text;
   readerSubscriptions: vec SubscriptionEvent;
 };
type PaymentRequest = 
 record {
   expirationDate: int;
   paymentFee: text;
   readerPrincipalId: text;
   subaccount: blob;
   subscriptionEventId: text;
   subscriptionTimeInterval: SubscriptionTimeInterval;
   writerPrincipalId: text;
 };
type PaymentMethod = 
 variant {
   Fiat: record {
           stripeSubscriptionId: text;
           usdAmountCents: text;
         };
   Token;
 };
type Icrc28TrustedOriginsResponse = record {trusted_origins: vec text;};
service : {
  acceptCycles: () -> ();
  authorizeForProxy: (text) -> ();
  authorizeForProxyAsEditor: (text, text) -> (Result_1);
  availableCycles: () -> (nat) query;
  cancelStripeSubscription: (text, text, text, text) -> (Result_1);
  checkMyExpiredSubscriptionsNotifications: () -> ();
  checkProxyAuthorization: (text, text) -> (bool) query;
  completeSubscriptionEvent: (text) -> (Result_2);
  consumeProxyAuthorization: (text) -> ();
  createPaymentRequestAsReader: (text, SubscriptionTimeInterval, nat) ->
   (Result_5);
  deactivateStripeAccount: (text) -> (Result);
  disperseTokensForSuccessfulSubscription: (text) -> (Result_1);
  expiredNotificationsHeartbeatExternal: () -> ();
  getAuthorActivePaidSubscriberPrincipalIds: (text) -> (vec text) query;
  getCanisterVersion: () -> (text) query;
  getLatestTimerCall: () -> (text, text) query;
  getMaxMemorySize: () -> (nat) query;
  getMemorySize: () -> (nat) query;
  getPaymentRequestBySubscriptionEventId: (text) -> (Result_5) query;
  getReaderSubscriptionDetails: () -> (Result_2) query;
  getStripeAccountId: (text) -> (opt text) query;
  getStripeCustomerId: (text) -> (opt text) query;
  getTrustedProxyPrincipal: () -> (text) query;
  getWriterSubscriptionDetails: (opt text) -> (Result) composite_query;
  getWriterSubscriptionDetailsByPrincipalId: (text) -> (Result) query;
  icrc10_supported_standards: () -> (vec SupportedStandard) query;
  icrc28_trusted_origins: () -> (Icrc28TrustedOriginsResponse);
  isReaderSubscriber: (text, text) -> (bool) query;
  isThereEnoughMemory: () -> (bool) query;
  isWriterActivatedSubscription: (text) -> (bool) query;
  pendingStuckTokensHeartbeatExternal: () -> ();
  pendingTokensHeartbeatExternal: () -> ();
  sendNewSubscriptionNotifications: (SubscriptionEvent) -> ();
  sendStopSubscriptionNotification: (text, text) -> ();
  setMaxMemorySize: (nat) -> (Result_4);
  setStripeAccountActive: (text, bool) -> (Result);
  setStripeSubscriptionCancelState: (text, text, text, bool, int) ->
   (Result_1);
  setTrustedProxyPrincipal: (text) -> (Result_3);
  stopSubscription: (text) -> (Result_2);
  syncStripeSubscription: (text, text, text, SubscriptionTimeInterval, 
   text, text, int, text) -> (Result_1);
  updateStripeAccount: (text, text) -> (Result);
  updateStripePriceTier: (text, SubscriptionTimeInterval, text, text) ->
   (Result);
  updateSubscriptionDetails: (UpdateSubscriptionDetailsModel) -> (Result);
}
