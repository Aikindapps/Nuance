type SupportedStandard = 
 record {
   name: text;
   url: text;
 };
type SearchByTagsResponse = 
 record {
   postIds: vec text;
   totalCount: text;
 };
type Result = 
 variant {
   err: text;
   ok: nat;
 };
type IndexPostModel = 
 record {
   content: text;
   postId: text;
   subtitle: text;
   tags: vec text;
   title: text;
 };
type Icrc28TrustedOriginsResponse = record {trusted_origins: vec text;};
service : {
  acceptCycles: () -> ();
  availableCycles: () -> (nat) query;
  debug_print_everything: () -> () query;
  getCanisterVersion: () -> (text) query;
  getMaxMemorySize: () -> (nat) query;
  getMemorySize: () -> (nat) query;
  getRelatedPosts: (postId: text) -> (vec text) query;
  icrc10_supported_standards: () -> (vec SupportedStandard) query;
  icrc28_trusted_origins: () -> (Icrc28TrustedOriginsResponse);
  indexPost: (indexPostModel: IndexPostModel) -> ();
  indexPosts: (indexPostModels: vec IndexPostModel) -> ();
  isThereEnoughMemory: () -> (bool) query;
  removePost: (postId: text) -> ();
  searchByTag: (tagName: text) -> (vec text) query;
  searchByTagWithinPublication: (tagName: text, publicationHandle: text) ->
   (vec text) composite_query;
  searchByTags: (tagNames: vec text, indexFrom: nat32, indexTo: nat32) ->
   (SearchByTagsResponse) query;
  searchPost: (searchTerm: text) -> (vec text) query;
  searchPublicationPosts: (searchTerm: text, publicationHandle: text) ->
   (vec text) composite_query;
  setMaxMemorySize: (newValue: nat) -> (Result);
}
