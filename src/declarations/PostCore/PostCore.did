 };
type ContentStatus = 
 variant {
   approved;
   new;
   rejected;
 };
type ContentResult = 
 record {
   approvedCount: nat;
   rejectedCount: nat;
   sourceId: text;
   status: ContentStatus;
   violatedRules: vec ViolatedRules;
 };
