   isPublication: bool;
   modified: text;
   nftCanisterId: opt text;
   postId: text;
   publishedDate: text;
   subtitle: text;
   tags: vec PostTagModel;
   title: text;
   url: text;
   views: text;
   wordCount: text;
 };
type PopularityType = 
 variant {
   ever;
