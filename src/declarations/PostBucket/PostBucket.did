type Validate = 
 variant {
   Err: text;
   Ok: text;
 };
type SupportedStandard = 
 record {
   name: text;
   url: text;
 };
type SaveResult = 
 variant {
   err: text;
   ok: PostBucketType;
 };
type SaveCommentModel = 
 record {
   commentId: opt text;
   content: text;
   postId: text;
   replyToCommentId: opt text;
 };
type Result_9 = 
 variant {
   err: text;
   ok: vec text;
 };
type Result_8 = 
 variant {
   err: text;
   ok: bool;
 };
type Result_7 = 
 variant {
   err: text;
   ok: record {
         nat;
         vec text;
       };
 };
type Result_6 = 
 variant {
   err: text;
   ok: PostBucketType;
 };
type Result_5 = 
 variant {
   err: text;
   ok: Comment;
 };
type Result_4 = 
 variant {
   err: text;
   ok: nat;
 };
type Result_3 = 
 variant {
   err: text;
   ok;
 };
type Result_2 = 
 variant {
   err: text;
   ok: text;
 };
type Result_11 = 
 variant {
   err: text;
   ok: Applaud;
 };
type Result_10 = 
 variant {
   err: text;
   ok: vec Comment;
 };
type Result_1 = 
 variant {
   err: text;
   ok: Post;
 };
type Result = 
 variant {
   err: text;
   ok: CommentsReturnType;
 };
type PostTagModel = 
 record {
   tagId: text;
   tagName: text;
 };
type PostSaveModel = 
 record {
   caller: principal;
   category: text;
   content: text;
   creatorHandle: text;
   handle: text;
   headerImage: text;
   isDraft: bool;
   isMembersOnly: bool;
   isPublication: bool;
   postId: text;
   postOwnerPrincipalId: text;
   premium:
    opt
     record {
       editorPrincipals: vec text;
       icpPrice: nat;
       maxSupply: nat;
       thumbnail: text;
     };
   scheduledPublishedDate: opt int;
   subtitle: text;
   tagNames: vec text;
   title: text;
 };
type PostBucketType = 
 record {
   bucketCanisterId: text;
   category: text;
   content: text;
   created: text;
   creatorHandle: text;
   creatorPrincipal: text;
   handle: text;
   headerImage: text;
   isDraft: bool;
   isMembersOnly: bool;
   isPremium: bool;
   isPublication: bool;
   modified: text;
   nftCanisterId: opt text;
   postId: text;
   postOwnerPrincipal: text;
   publishedDate: text;
   subtitle: text;
   title: text;
   url: text;
   wordCount: text;
 };
type PostBucket = 
 service {
   acceptCycles: () -> ();
   addPostCategory: (postId: text, category: text) -> (Result_6);
   addPostIdToUserDebug: (principalId: text, postId: text) -> (Result_3);
   availableCycles: () -> (nat) query;
   buildCommentUrl: (commentId: text) -> (text) query;
   checkTipping: (postId: text) -> ();
   checkTippingByTokenSymbol: (postId: text, symbol: text, senderPrincipal:
    text) -> (Result_11);
   debugMembersOnlyStatusOfExistingDraftArticles: () -> (Result_9);
   debugSetCreatorFieldAndAddPostIdToUser: (postId: text, creatorPrincipal:
    text) -> (Result_6);
   delete: (postId: text) -> (Result_4);
   deleteComment: (commentId: text) -> (Result_5);
   deleteUserPosts: (principalId: text) -> (Result_4);
   downvoteComment: (commentId: text) -> (Result);
   dumpIds: () -> (Result_3);
   dumpPosts: () -> (Result_3);
   dumpUserIds: () -> (Result_3);
   fixEmptyCreatorFields: (publicationPrincipalId: text,
    assigningWriterPrincipalId: text) -> (Result_4);
   generatePublishedDates: () -> ();
   getAdmins: () -> (Result_9) query;
   getAllApplauds: () -> (vec Applaud) query;
   getAllNotMigratedCreatorFields: () -> (vec text) query;
   getAllRejected: () -> (vec record {
                                text;
                                text;
                              }) query;
   getApplaudById: (applaudId: text) -> (Result_11) query;
   getBucketCanisterVersion: () -> (text) query;
   getCanisterVersion: () -> (text) query;
   getCgUsers: () -> (Result_9) query;
   getComment: (commentId: text) -> (Result_5) query;
   getFrontendCanisterId: () -> (text) query;
   getKinicList: () -> (Result_9) query;
   getList: (postIds: vec text) -> (vec PostBucketType) query;
   getMaxMemorySize: () -> (nat) query;
   getMemorySize: () -> (nat) query;
   getMyApplauds: () -> (vec Applaud) query;
   getNotMigratedPremiumArticlePostIds: () -> (vec text) query;
   getPlatformOperators: () -> (List) query;
   getPost: (postId: text) -> (Result_6) query;
   getPostApplauds: (postId: text) -> (vec Applaud) query;
   getPostComments: (postId: text) -> (Result) query;
   getPostCompositeQuery: (postId: text) -> (Result_6) composite_query;
   getPostCoreCanisterId: () -> (text) query;
   getPostUrls: () -> (Result_2) query;
   getPostsByPostIds: (postIds: vec text, includeDraft: bool) ->
    (vec PostBucketType) query;
   getPostsByPostIdsMigration: (postIds: vec text) ->
    (vec PostBucketType) query;
   getPublicationPosts: (postIds: vec text, publicationHandle: text) ->
    (vec PostBucketType) composite_query;
   getReportedCommentIds: () -> (vec text);
   getReportedComments: () -> (Result_10) query;
   getTotalPostCount: () -> (nat) query;
   getTrustedCanisters: () -> (Result_9) query;
   getUserApplaudsByPrincipal: (principalId: text) -> (vec Applaud) query;
   getUserPostIds: (principalId: text) -> (vec text) query;
   getUserPosts: (handle: text, includeDraft: bool) ->
    (vec PostBucketType) query;
   icrc10_supported_standards: () -> (vec SupportedStandard) query;
   icrc28_trusted_origins: () -> (Icrc28TrustedOriginsResponse);
   initializeBucketCanister: (nuanceCanistersInitial: vec text,
    cgUsersInitial: vec text, initPostCoreCanisterId: text) -> (Result_2);
   initializeCanister: (postIndexCai: text, userCai: text) -> (Result_2);
   isBucketCanisterActivePublic: () -> (bool) query;
   makeBucketCanisterNonActive: () -> (Result_8);
   migrateCreatorsFromHandlesToPrincipals: () -> (Result_7);
   migratePostToPublication: (postId: text, publicationHandle: text, isDraft:
    bool) -> (Result_1);
   migratePremiumArticleFromOldArch: (postId: text, price: opt nat) ->
    (Result_2);
   registerAdmin: (id: text) -> (Result_3);
   registerCanister: (id: text) -> (Result_3);
   registerCgUser: (id: text) -> (Result_3);
   registerPlatformOperator: (id: text) -> (Result_3);
   reindex: () -> (Result_2);
   rejectPostByModclub: (postId: text) -> () oneway;
   removeCommentVote: (commentId: text) -> (Result);
   removePostCategory: (postId: text) -> (Result_6);
   removePostIdToUserDebug: (principalId: text, postId: text) -> (Result_3);
   reportComment: (commentId: text) -> (Result_2);
   reviewComment: (commentId: text, censor: bool) -> (Result_5);
   save: (postModel: PostSaveModel) -> (SaveResult);
   saveComment: (input: SaveCommentModel) -> (Result);
   saveMultiple: (postModels: vec PostSaveModel) -> (vec SaveResult);
   sendNewCommentNotification: (commentId: text) -> ();
   setMaxMemorySize: (newValue: nat) -> (Result_4);
   storeHandlesAndPrincipals: (handlesAndPrincipalIds:
    vec record {
          text;
          text;
        }) -> (Result_2);
   testInstructionSize: () -> (text);
   unRejectPostByModclub: (postId: text) -> () oneway;
   unregisterAdmin: (id: text) -> (Result_3);
   unregisterCanister: (id: text) -> (Result_3);
   unregisterCgUser: (id: text) -> (Result_3);
   unregisterPlatformOperator: (id: text) -> (Result_3);
   updateHandle: (principalId: text, newHandle: text) -> (Result_2);
   updatePostDraft: (postId: text, isDraft: bool) -> (Result_1);
   upvoteComment: (commentId: text) -> (Result);
   validate: (input: reserved) -> (Validate);
 };
type Post = 
 record {
   bucketCanisterId: text;
   category: text;
   claps: text;
   content: text;
   created: text;
   creatorHandle: text;
   creatorPrincipal: text;
   handle: text;
   headerImage: text;
   isDraft: bool;
   isMembersOnly: bool;
   isPremium: bool;
   isPublication: bool;
   modified: text;
   nftCanisterId: opt text;
   postId: text;
   publishedDate: text;
   subtitle: text;
   tags: vec PostTagModel;
   title: text;
   url: text;
   views: text;
   wordCount: text;
 };
type List = 
 opt record {
       text;
       List;
     };
type Icrc28TrustedOriginsResponse = record {trusted_origins: vec text;};
type CommentsReturnType = 
 record {
   comments: vec Comment;
   totalNumberOfComments: text;
 };
type Comment = 
 record {
   avatar: text;
   bucketCanisterId: text;
   commentId: text;
   content: text;
   createdAt: text;
   creator: text;
   downVotes: vec text;
   editedAt: opt text;
   handle: text;
   isCensored: bool;
   isVerified: bool;
   postId: text;
   repliedCommentId: opt text;
   replies: vec Comment;
   upVotes: vec text;
 };
type Applaud = 
 record {
   applaudId: text;
   bucketCanisterId: text;
   currency: text;
   date: text;
   numberOfApplauds: nat;
   postId: text;
   receivedTokenAmount: nat;
   receiver: text;
   sender: text;
   tokenAmount: nat;
 };
service : () -> PostBucket
