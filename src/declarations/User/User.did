type WriterSubscriptionDetails = 
 record {
   annuallyFee: opt text;
   isSubscriptionActive: bool;
   lifeTimeFee: opt text;
   monthlyFee: opt text;
   paymentReceiverPrincipalId: text;
   weeklyFee: opt text;
   writerPrincipalId: text;
   writerSubscriptions: vec SubscriptionEvent;
 };
type VerifyResult = 
 variant {
   Err: text;
   Ok: UniquePersonProof;
 };
type Validate = 
 variant {
   Err: text;
   Ok: text;
 };
type UserListItem = 
 record {
   avatar: text;
   bio: text;
   displayName: text;
   followersCount: text;
   fontType: text;
   handle: text;
   isVerified: bool;
   "principal": text;
   socialChannelsUrls: vec text;
   website: text;
 };
type UserClaimInfo = 
 record {
   isClaimActive: bool;
   isUserBlocked: bool;
   lastClaimDate: opt text;
   maxClaimableTokens: text;
   subaccount: opt blob;
 };
type User = 
 record {
   accountCreated: text;
   avatar: text;
   bio: text;
   claimInfo: UserClaimInfo;
   displayName: text;
   followers: Followers;
   followersArray: vec text;
   followersCount: nat32;
   followersPrincipals: FollowersPrincipals;
   handle: text;
   isVerified: bool;
   nuaTokens: float64;
   publicationsArray: vec PublicationObject;
   socialChannels: vec text;
   website: text;
 };
type UpdateCallsAggregatedData = vec nat64;
type UniquePersonProofProvider = variant {DecideAI;};
type UniquePersonProof = 
 record {
   provider: UniquePersonProofProvider;
   timestamp: nat64;
 };
type SupportedStandard = 
 record {
   name: text;
   url: text;
 };
type SubscriptionTimeInterval = 
 variant {
   Annually;
   LifeTime;
   Monthly;
   Weekly;
 };
type SubscriptionEvent = 
 record {
   endTime: int;
   isWriterSubscriptionActive: bool;
   paymentFee: text;
   readerPrincipalId: text;
   startTime: int;
   subscriptionEventId: text;
   subscriptionTimeInterval: SubscriptionTimeInterval;
   writerPrincipalId: text;
 };
type Result_9 = 
 variant {
   err: text;
   ok: vec text;
 };
type Result_8 = 
 variant {
   err: text;
   ok: record {
         nat;
         nat;
       };
 };
type Result_7 = 
 variant {
   err: text;
   ok: record {
         batchesFailed: nat;
         batchesSent: nat;
         totalRecipients: nat;
       };
 };
type Result_6 = 
 variant {
   err: text;
   ok: bool;
 };
type Result_5 = 
 variant {
   err: text;
   ok: nat;
 };
type Result_4 = 
 variant {
   err: text;
   ok: ReaderSubscriptionDetails;
 };
type Result_3 = 
 variant {
   err: text;
   ok;
 };
type Result_2 = 
 variant {
   err: text;
   ok: text;
 };
type Result_16 = 
 variant {
   err: text;
   ok: opt text;
 };
type Result_15 = 
 variant {
   err: text;
   ok: vec record {
             text;
             nat;
           };
 };
type Result_14 = 
 variant {
   err: text;
   ok: vec EmailSubscriber;
 };
type Result_13 = 
 variant {
   err: text;
   ok: vec User;
 };
type Result_12 = 
 variant {
   err: text;
   ok: vec UserListItem;
 };
type Result_11 = 
 variant {
   err: text;
   ok: vec EmailBatchSummary;
 };
type Result_10 = 
 variant {
   err: text;
   ok: UserListItem;
 };
type Result_1 = 
 variant {
   err: text;
   ok: User;
 };
type Result = 
 variant {
   err: text;
   ok: record {
         authorHandle: text;
         email: text;
       };
 };
type RemovePublicationReturn = 
 variant {
   err: text;
   ok: User;
 };
type RegisterUserReturn = 
 variant {
   err: text;
   ok: User;
 };
type ReaderSubscriptionDetails = 
 record {
   readerNotStoppedSubscriptionsWriters: vec WriterSubscriptionDetails;
   readerPrincipalId: text;
   readerSubscriptions: vec SubscriptionEvent;
 };
type PublishedArticlePayload = 
 record {
   authorAvatar: text;
   authorDisplayName: text;
   authorHandle: text;
   authorPrincipal: text;
   contentHtml: text;
   headerImage: text;
   isMembersOnly: bool;
   postId: text;
   publicationAvatar: opt text;
   publicationDisplayName: opt text;
   publicationHandle: opt text;
   publishedAt: int;
   subtitle: text;
   title: text;
   url: text;
 };
type PublicationObject = 
 record {
   isEditor: bool;
   publicationName: text;
 };
type NumericEntity = 
 record {
   avg: nat64;
   first: nat64;
   last: nat64;
   max: nat64;
   min: nat64;
 };
type NuaBalanceResult = 
 variant {
   err: text;
   ok: text;
 };
type MetricsGranularity = 
 variant {
   daily;
   hourly;
 };
type List = 
 opt record {
       text;
       List;
     };
type Icrc28TrustedOriginsResponse = record {trusted_origins: vec text;};
type HourlyMetricsData = 
 record {
   canisterCycles: CanisterCyclesAggregatedData;
   canisterHeapMemorySize: CanisterHeapMemoryAggregatedData;
   canisterMemorySize: CanisterMemoryAggregatedData;
   timeMillis: int;
   updateCalls: UpdateCallsAggregatedData;
 };
type GetPrincipalByHandleReturn = 
 variant {
   err: text;
   ok: opt text;
 };
type GetMetricsParameters = 
 record {
   dateFromMillis: nat;
   dateToMillis: nat;
   granularity: MetricsGranularity;
 };
type GetHandleByPrincipalReturn = 
 variant {
   err: text;
   ok: opt text;
 };
type FollowersPrincipals = 
 opt record {
       text;
       List;
     };
type Followers = 
 opt record {
       text;
       List;
     };
type EmailSubscriber = 
 record {
   authorPrincipal: text;
   createdAt: int;
   email: text;
   unsubscribedAt: opt int;
   userId: opt text;
   verified: bool;
   verifiedAt: opt int;
 };
type EmailBatchSummary = 
 record {
   attempts: nat;
   authorPrincipal: text;
   firstAttemptedAt: int;
   id: text;
   lastError: text;
   nextAttemptAt: int;
   postId: text;
   recipientCount: nat;
   updatedAt: int;
 };
type Date = 
 record {
   day: nat;
   hour: nat;
   month: nat;
   year: nat;
 };
type DailyMetricsData = 
 record {
   canisterCycles: NumericEntity;
   canisterHeapMemorySize: NumericEntity;
   canisterMemorySize: NumericEntity;
   timeMillis: int;
   updateCalls: nat64;
 };
type CanisterMetricsData = 
 variant {
   daily: vec DailyMetricsData;
   hourly: vec HourlyMetricsData;
 };
type CanisterMetrics = record {data: CanisterMetricsData;};
type CanisterMemoryAggregatedData = vec nat64;
type CanisterHeapMemoryAggregatedData = vec nat64;
type CanisterCyclesAggregatedData = vec nat64;
type AddPublicationReturn = 
 variant {
   err: text;
   ok: User;
 };
service : {
  acceptCycles: () -> ();
  addNuaBalance: (handle: text) -> () oneway;
  addPublication: (publication: PublicationObject, callerId: text) ->
   (AddPublicationReturn);
  adminAirDrop: (amount: float64) -> (Result_2);
  /// Admin: read back the configured client_id. The secret is never
  /// returned by any query — rotate it by setting a new value.
  adminGetDecideIdClientId: () -> (Result_16) query;
  /// Whether a client_secret has been configured. Exposed (without the
  /// value) so the admin UI can show configuration status.
  adminIsDecideIdClientSecretSet: () -> (Result_6) query;
  /// Admin: set the DecideID OIDC client_id. Pass null to clear.
  adminSetDecideIdClientId: (value: opt text) -> (Result_3);
  /// Admin: set the DecideID OIDC client_secret. Pass null to clear.
  adminSetDecideIdClientSecret: (value: opt text) -> (Result_3);
  availableCycles: () -> (nat) query;
  blockUserFromClaiming: (handle: text) -> (Result_3);
  checkMyClaimNotification: () -> ();
  claimRestrictedTokens: () -> (Result_1);
  clearAllMyFollowers: () -> (text);
  collectCanisterMetrics: () -> ();
  /// Begin an OIDC authorization flow. Returns a random `state` value
  /// the frontend must include in the authorize redirect; the canister
  /// remembers it so only the same caller (with the same redirect URI)
  /// can later redeem the resulting code.
  createDecideIdState: (redirectUri: text) -> (Result_2);
  deleteConfirmedLinkings: () -> (Result_3);
  deleteUser: (principalId: text) -> (Result_5);
  dumpUsers: () -> (text) query;
  followAuthor: (author: text) -> (Result_1);
  generateAccountIds: () -> ();
  generateLowercaseHandles: () -> (text, vec text);
  getActiveUsersByRange: (date: Date) -> (nat) query;
  getAdmins: () -> (Result_9) query;
  getAllClaimSubaccountIndexes: () -> (Result_15) query;
  getAllHandles: () -> (vec text) query;
  getAllUserPrincipals: () -> (Result_9) query;
  getCanisterMetrics: (parameters: GetMetricsParameters) ->
   (opt CanisterMetrics) query;
  getCanisterVersion: () -> (text) query;
  getCgUsers: () -> (Result_9) query;
  getDailyMaxRegistration: () -> (nat) query;
  getDeadEmailBatches: () -> (Result_11) query;
  /// Admin-only: list email subscribers for an author (for export/debug).
  getEmailSubscribersOfAuthor: (authorPrincipal: text) -> (Result_14) query;
  /// List email subscribers of a publication. Authorized for: editors of the
  /// publication (looked up via PostCore), the publication canister itself,
  /// admins, and platform operators. Composite query because the editor
  /// check requires an inter-canister query to PostCore.
  getEmailSubscribersOfPublication: (publicationCanisterId: text) ->
   (Result_14) composite_query;
  getFollowersByPrincipalId: (principalId: principal) ->
   (vec UserListItem) query;
  getFollowersCount: (handle: text) -> (text) query;
  getFollowersPrincipalIdsByPrincipalId: (principalId: text) ->
   (vec text) query;
  getHandleByPrincipal: ("principal": text) ->
   (GetHandleByPrincipalReturn) query;
  getHandlesByAccountIdentifiers: (accountIds: vec text) -> (vec text) query;
  getHandlesByPrincipals: (principals: vec text) -> (vec text) query;
  getLastDayClaimedTokensAmount: () -> (nat) query;
  getLastDayNumberOfClaimEvents: () -> (nat) query;
  getLinkedPrincipal: (walletPrincipal: text) -> (Result_2) query;
  getMaxMemorySize: () -> (nat) query;
  getMemorySize: () -> (nat) query;
  getMultipleUsersByPrincipalId: (userPrincipalIds: vec text) ->
   (Result_13) query;
  getMyFollowers: () -> (Result_12) query;
  getNuaBalance: (principalId: text) -> (NuaBalanceResult) query;
  getNumberOfAllRegisteredUsers: () -> (nat) query;
  getPendingEmailBatches: () -> (Result_11) query;
  getPlatformOperators: () -> (List) query;
  getPrincipalByHandle: (handle: text) -> (GetPrincipalByHandleReturn) query;
  getPrincipalsByHandles: (handles: vec text) -> (vec text) query;
  getRegistrationNumberLastDay: () -> (nat) query;
  getTotalNumberOfClaimedTokens: () -> (nat) query;
  getTrustedCanisters: () -> (Result_9) query;
  getUser: () -> (Result_1) query;
  getUserByHandle: (handle: text) -> (Result_1) query;
  getUserByPrincipalId: (userPrincipalId: text) -> (Result_1) query;
  getUserFollowers: (handle: text) -> (vec UserListItem) query;
  getUserInternal: (userPrincipalId: text) -> (opt User) query;
  getUserListItemByHandle: (handle: text) -> (Result_10) query;
  getUsersBlockedFromClaiming: () -> (Result_9) query;
  getUsersByHandles: (handles: vec text) -> (vec UserListItem) query;
  getUsersByPrincipals: (principals: vec text) -> (vec UserListItem) query;
  getVerificationStatus: (principalId: text) -> (Result_6) query;
  handleClap: (postCaller: text, handle: text) -> () oneway;
  /// Returns true if the API key is configured (no value returned).
  hasLettermintApiKey: () -> (bool) query;
  icrc10_supported_standards: () -> (vec SupportedStandard) query;
  icrc28_trusted_origins: () -> (Icrc28TrustedOriginsResponse);
  /// Query: is a given email verified-subscribed to this author?
  /// Used by the frontend to render the "Subscribed" state.
  isEmailSubscribed: (authorHandle: text, email: text) -> (bool) query;
  /// Query: is the calling principal email-subscribed to this author or publication?
  /// Pass publicationCanisterId when checking a publication; omit (null) for individual authors.
  /// Returns false for anonymous callers or when no verified subscription exists.
  isEmailSubscribedByCaller: (authorHandle: text, publicationCanisterId:
   opt text) -> (bool) query;
  isRegistrationOpen: () -> (bool) query;
  isThereEnoughMemory: () -> (bool) query;
  linkInternetIdentityConfirm: (walletPrincipal: text) -> (Result_3);
  linkInternetIdentityRequest: (walletPrincipal: text, iiPrincipal: text) ->
   (Result_3);
  migrateFollowersHashmapsFromHandlesToPrincipalIds: () -> (Result_8);
  /// Invoked by PostBucket right after an article transitions to
  /// "published". Filters subscribers by members-only rules and fans out
  /// Lettermint batch calls in chunks of BATCH_SIZE.
  /// 
  /// Authorization: only trusted Nuance canisters (PostBucket, PostCore,
  /// etc.) registered via registerCanister.
  notifyAuthorArticlePublished: (payload: PublishedArticlePayload,
   paidSubscriberPrincipalIds: vec text, subscriptionTargetIds: vec text) ->
   (Result_7);
  /// Admin-triggered immediate drain — handy for testing the retry path
  /// without waiting for the next timer tick.
  processPendingEmailBatchesNow: () -> (Result_2);
  registerAdmin: (id: text) -> (Result_3);
  registerCanister: (id: text) -> (Result_3);
  registerCgUser: (id: text) -> (Result_3);
  registerPlatformOperator: (id: text) -> (Result_3);
  registerUser: (handle: text, displayName: text, avatar: text) ->
   (RegisterUserReturn);
  removePoh: (handle: text) -> (Result_1);
  removePublication: (publication: PublicationObject, callerId: text) ->
   (RemovePublicationReturn);
  /// Re-queue a dead-lettered batch — useful when the underlying cause
  /// of a 4xx (e.g. a misconfigured From domain) has been resolved.
  /// Resets the attempt counter so the batch gets the full retry schedule
  /// again. NOTE: if the original send happened > 24h ago, the Lettermint
  /// idempotency key will have expired and a true duplicate is possible.
  retryDeadEmailBatch: (id: text) -> (Result_2);
  setDailyMaxRegistration: (newVal: nat) -> (Result_5);
  setIsClaimActive: (isActive: bool) -> (Result_6);
  /// Admin sets the Lettermint API key. Not queryable.
  setLettermintApiKey: (key: text) -> (Result_3);
  setMaxMemorySize: (newValue: nat) -> (Result_5);
  setMaxNumberOfClaimableTokens: (amount: nat) -> (Result_5);
  setMaxNumberOfDailyClaimableTokens: (amount: nat) -> (Result_5);
  spendNuaBalance: (user: text) -> () oneway;
  spendRestrictedTokensForSubscription: (eventId: text, amount: nat) ->
   (Result_4);
  spendRestrictedTokensForTipping: (bucketCanisterId: text, postId: text,
   amount: nat) -> (Result_3);
  /// Subscribe an email to an author's publishing broadcasts.
  /// 
  /// - `authorHandle`: public handle the subscriber sees on the author page.
  /// - `email`: raw email text (we normalize + validate).
  /// - `verificationBaseUrl`: the frontend URL the token is appended to
  ///   (e.g. "https://nuance.xyz/verify-email"). Must match a trusted
  ///   Nuance origin — see isTrustedEmailOrigin.
  /// 
  /// Returns a harmless success message whether the email is new, already
  /// pending, or already verified. This prevents enumeration: an attacker
  /// can't use this endpoint to test which emails are subscribed.
  /// A verification email is only actually sent when it makes sense.
  subscribeToAuthorByEmail: (authorHandle: text, email: text,
   verificationBaseUrl: text) -> (Result_2);
  /// Subscribe an email to a publication's article-broadcast list.
  /// Mirrors subscribeToAuthorByEmail but the target is a publication
  /// rather than a user. The User canister doesn't track publications,
  /// so the caller (frontend) supplies the publication canister ID
  /// directly — it's used as the `authorPrincipal` in the subscriber/index maps.
  /// Display name + handle are passed in for the verification email and
  /// rate-limit key only; we don't store them.
  subscribeToPublicationByEmail: (publicationCanisterId: text,
   publicationHandle: text, publicationDisplayName: text, email: text,
   verificationBaseUrl: text) -> (Result_2);
  testInstructionSize: () -> (text);
  unblockUserFromClaiming: (handle: text) -> (Result_3);
  unfollowAuthor: (author: text) -> (Result_1);
  unregisterAdmin: (id: text) -> (Result_3);
  unregisterCanister: (id: text) -> (Result_3);
  unregisterCgUser: (id: text) -> (Result_3);
  unregisterPlatformOperator: (id: text) -> (Result_3);
  /// Update: unsubscribe the calling principal from an author or publication email list.
  /// Pass publicationCanisterId for publications; omit (null) for individual authors.
  unsubscribeEmailByCaller: (authorHandle: text, publicationCanisterId:
   opt text) -> (Result_2);
  /// Unsubscribe using the broadcast token + the recipient's email
  /// (both included in the email footer link). The token is shared
  /// across the whole broadcast and only authenticates "this URL came
  /// from a real Nuance broadcast"; the email param identifies which
  /// subscriber to mark unsubscribed.
  /// 
  /// A broadcast's recipient may be subscribed to multiple targets at
  /// once (e.g. both the author and a publication that re-published the
  /// article). They received a single deduped email, and clicking
  /// Unsubscribe should silence them across every target on this
  /// broadcast — otherwise they'd keep receiving copies from the
  /// remaining target.
  /// 
  /// Do NOT delete the token on success — other recipients in the same
  /// broadcast share it and still need it to unsubscribe.
  unsubscribeEmailByToken: (token: text, email: text) -> (Result_2);
  /// Unsubscribe while logged in (email from UI; authorHandle from UI).
  unsubscribeFromAuthorByEmail: (authorHandle: text, email: text) ->
   (Result_2);
  updateAvatar: (avatarUrl: text) -> (Result_1);
  updateBio: (bio: text) -> (Result_1);
  updateDisplayName: (displayName: text) -> (Result_1);
  updateFontType: (fontType: text) -> (Result_1);
  updateHandle: (existingHandle: text, newHandle: text, postCoreCanisterId:
   text, publicationWritersEditorsPrincipals: opt vec text) -> (Result_1);
  updateLastLogin: () -> () oneway;
  updateSocialLinks: (websiteUrl: text, socialChannelsUrls: vec text) ->
   (Result_1);
  updateUserDetails: (bio: text, avatarUrl: text, displayName: text,
   websiteUrl: text, socialChannelsUrls: vec text) -> (Result_1);
  validate: (input: reserved) -> (Validate);
  /// Verify a token and mark the subscriber as verified. Idempotent —
  /// calling twice with the same token after it was consumed returns
  /// the expected error, but calling twice during the valid window is
  /// safe (no-ops on second call because the token is gone).
  verifyEmailSubscription: (token: text) -> (Result);
  /// Exchange a DecideID authorization code for a userinfo response,
  /// and on `verified=true` mark the calling user as PoH-verified.
  /// 
  /// The legacy VerifyResult shape is preserved so the frontend store
  /// can keep its `'Ok' in result` / `result.Err` branching. The
  /// `timestamp` field is set to the canister time when verification
  /// succeeded — we no longer have a credential-issuance timestamp.
  verifyPoh: (code: text, state: text, redirectUri: text) -> (VerifyResult);
}
